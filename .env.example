# Frontend (Next.js) environment variables.
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at BUILD time,
# so rebuild after changing them.

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# SwasthyaSetu user-support contact (NOT an emergency number).
# Leave empty (or keep the placeholder) to show "Support number currently unavailable."
NEXT_PUBLIC_SUPPORT_PHONE=1800-XXX-XXXX
# Optional. Shown in the Help & Support panel when set to a valid address.
NEXT_PUBLIC_SUPPORT_EMAIL=
