# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# Postgres (used to build DATABASE_URL if not set directly)
POSTGRES_USER=swasthyasetu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=swasthyasetu
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Full async SQLAlchemy DSN, e.g.:
# postgresql+asyncpg://swasthyasetu:change_me@localhost:55432/swasthyasetu
DATABASE_URL=postgresql+asyncpg://swasthyasetu:change_me@localhost:55432/swasthyasetu

# Used only by tests (separate DB)
TEST_DATABASE_URL=postgresql+asyncpg://swasthyasetu:change_me@localhost:55432/swasthyasetu_test

# JWT secrets - generate with `openssl rand -hex 32`
JWT_SECRET_KEY=please_change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Gemini API key used server-side only by the symptom-summary pipeline.
# Get one at https://aistudio.google.com/apikey — never commit a real key.
GEMINI_API_KEY=

# Used to build the link inside verification emails.
FRONTEND_BASE_URL=http://localhost:3000

# Outgoing verification email. Hosts like Railway/Render block outbound SMTP
# ports, so Brevo/Resend (HTTPS APIs) are tried first, in that order; SMTP is
# only used as a fallback where it isn't blocked (e.g. local dev). Leave all
# of these blank to use the dev-log fallback (verification links are logged
# server-side instead of emailed).
# Brevo (https://app.brevo.com): free HTTPS API, only needs a single verified
# sender email (Senders > add + verify) — no owned domain required, and can
# then deliver to any recipient. Get the API key under SMTP & API > API Keys.
BREVO_API_KEY=
# Resend (https://resend.com): HTTPS API, but a sandbox key can only deliver
# to the Resend account's own email until a domain is verified there.
RESEND_API_KEY=
# For Gmail SMTP fallback: use an App Password (not your account password);
# requires 2FA enabled on the Google account. SMTP_FROM_EMAIL should match
# SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address/name used by whichever provider is active (Brevo/Resend/SMTP).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SwasthyaSetu

EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Set to false to let unverified accounts log in anyway (e.g. for
# demoing/exploring the app while email delivery isn't fully set up). The
# verification email/link is still sent either way.
EMAIL_VERIFICATION_REQUIRED=true

# Comma-separated allowed email domains per self-registration/provisioning
# role. Empty = no restriction (falls back to generic email format check).
ALLOWED_EMAIL_DOMAINS_PATIENT=gmail.com
ALLOWED_EMAIL_DOMAINS_HEALTH_WORKER=gmail.com
ALLOWED_EMAIL_DOMAINS_DOCTOR=
ALLOWED_EMAIL_DOMAINS_ADMIN=

RATE_LIMIT_ENABLED=true
